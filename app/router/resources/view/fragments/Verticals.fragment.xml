<core:FragmentDefinition xmlns:core="sap.ui.core"
                         xmlns="sap.m"
                         xmlns:f="sap.f"
                         xmlns:mdc="sap.ui.mdc"
                         xmlns:mdct="sap.ui.mdc.table">

 
            <VBox class="sapUiSmallMargin">
                <mdc:Table
                    class="verticalsTable"
                    id="Verticals"
                    header="Verticals"
                    autoBindOnInit="false"
                    busyIndicatorDelay="0"
                    width="50%"
                    p13nMode="Column,Sort,Filter,Group"
                    selectionMode="Multi"
                    delegate='{
                        "name": "project2/delegate/VerticalsTableDelegate",
                        "payload": {
                            "collectionPath": "Verticals"
                        }
                    }'
                    showRowCount="true"
                    threshold="1000"
                    enableExport="true"
                    enableAutoColumnWidth="false"
                    filter="verticalFilterBar"
                    filterConditions="{filterModel>/conditions}"
                    selectionChange="onSelectionChange">

                    <mdc:type>
                        <mdct:ResponsiveTableType />
                    </mdc:type>

                    <mdc:actions>

                            <HBox>
                                <Button id="saveButton_vert" text="Save" type="Accept" enabled="false" press="onSaveButtonPress" />
                                <Button id="cancelButton_vert" text="Cancel" type="Reject" enabled="false" press="onCancelButtonPress" class="sapUiSmallMarginBegin" />
                            </HBox>
                             <SegmentedButton
                                             selectedKey="less"
                                             selectionChange="onToggleRowDetail"
                                             tooltip="Toggle Row Details">
                                <items>
                                    <SegmentedButtonItem key="more"
                                                         icon="sap-icon://detail-more"
                                                         tooltip="Show More"/>
                                    <SegmentedButtonItem key="less"
                                                         icon="sap-icon://detail-less"
                                                         tooltip="Show Less"/>
                                </items>
                            </SegmentedButton>
                            <Button icon="sap-icon://add" id="btnAdd_vert" tooltip="Add" press="onAdd" />
                            <Button icon="sap-icon://delete" id="btnDelete_vert" tooltip="Delete" press="onDeletePress" enabled="false" />
                            <Button icon="sap-icon://edit" id="btnEdit_vert" tooltip="Edit" press="onEditPress" enabled="false" />
        
                    </mdc:actions>

                    <mdc:copyProvider>
                        <!-- <plugins:CopyProvider id="copyProvider_vert" /> -->
                    </mdc:copyProvider>
                </mdc:Table>
            </VBox>
</core:FragmentDefinition>